# ISMS Rust Backend — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env — it is in .gitignore

# Server
HOST=127.0.0.1
PORT=8080
RUST_LOG=info

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=isms

# JWT
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:5173

# Bcrypt
BCRYPT_COST=12

# Vanta Integration (optional — only needed for Vanta sync)
# VANTA_CLIENT_ID=
# VANTA_CLIENT_SECRET=
